# =====================================================================
#  LOLeague - environment variables
#  Copy to .env and fill in. NEVER commit the real .env.
# =====================================================================

# ---------- Postgres (docker-compose creates this database) ----------
POSTGRES_DB=loleague
POSTGRES_USER=loleague
POSTGRES_PASSWORD=change-me-db-password

# Spring services read these
DB_HOST=postgres
DB_PORT=5432
DB_NAME=loleague
DB_USER=loleague
DB_PASSWORD=change-me-db-password

# ---------- Auth / security ----------
# Shared by all three services. At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=loleague
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
# Service-to-service key (auth-service -> meme-service and chat-service). Generate: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-a-random-internal-key
# true in production (HTTPS). false only for http://localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Comma separated usernames that become admins (ads, goodie deliveries, payouts)
ADMIN_USERNAMES=

# ---------- Clerk (sign-in: phone OTP, Google, GitHub) ----------
# Dashboard > Configure > API keys. In "User & authentication" turn on Phone number (verify at sign-up,
# required), Google and GitHub, and keep phone numbers unique (Clerk's default).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Your Clerk Frontend API URL (the "iss" of session tokens), e.g. https://xyz.clerk.accounts.dev
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Origins allowed in the token's azp claim. Defaults to FRONTEND_URL.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# How often a student may change their username (ISO-8601 duration, P0D = no limit)
USERNAME_CHANGE_COOLDOWN=P7D

# ---------- AWS S3 (meme + avatar uploads) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=loleague-memes
# Public base URL of the bucket (or a CloudFront domain in front of it)
AWS_S3_PUBLIC_BASE_URL=https://loleague-memes.s3.ap-south-1.amazonaws.com
# Optional: S3-compatible endpoint (MinIO/LocalStack) for local dev. Leave empty for AWS.
AWS_S3_ENDPOINT=

# ---------- Chat ----------
# Free key from https://developers.giphy.com/dashboard/
GIPHY_API_KEY=your-giphy-api-key
# Origin(s) of the Next.js site allowed to open the chat WebSocket
FRONTEND_URL=http://localhost:3000
# What browsers connect to. On Render it is derived automatically if left empty.
CHAT_PUBLIC_WS_URL=ws://localhost:8083/ws

# ---------- Leaderboard ----------
# Weekly coins for rank 1..10 in each college
LEADERBOARD_REWARDS=10,5,3,2,1,1,1,1,1,1

# ---------- Next.js server-side proxy targets ----------
AUTH_SERVICE_URL=http://auth-service:8081
MEME_SERVICE_URL=http://meme-service:8082
CHAT_SERVICE_URL=http://chat-service:8083
